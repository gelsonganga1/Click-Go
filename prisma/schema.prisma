// prisma/schema.prisma

// Configuração do banco de dados SQLite
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // Ex: "file:./dev.db"
}

// Gerador do Prisma Client
generator client {
  provider = "prisma-client-js"
}

// Modelo de Usuário
model User {
  id         Int      @id @default(autoincrement())
  full_name  String
  email      String   @unique
  tel        String   @unique
  password   String
  birth_date DateTime?
  avatar_url String?
  criado_em  DateTime @default(now())
}

// Modelo de Instituição
model Institution {
  id               Int      @id @default(autoincrement())
  nome_instituicao String
  email            String   @unique
  tel              String   @unique
  password         String
  servicos         String?
  avatar_url       String?
  criado_em        DateTime @default(now())
}

// Modelo de Agendamento / Reserva
model Reservation {
  id               Int      @id @default(autoincrement())
  nome_completo    String
  email            String
  telefone         String
  documento        String?
  tipo_servico     String
  data_agendamento DateTime
  horario          String
  observacoes      String?
  status           String   @default("pendente")
  criado_em        DateTime @default(now())
}
