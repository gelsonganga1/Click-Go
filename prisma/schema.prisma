datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         Int      @id @default(autoincrement())
  full_name  String
  email      String   @unique
  tel        String   @unique
  password   String
  birth_date DateTime?
  avatar_url String?
  criado_em  DateTime @default(now())
}

model Institution {
  id               Int      @id @default(autoincrement())
  nome_instituicao String
  email            String   @unique
  tel              String   @unique
  password         String
  servicos         String?
  avatar_url       String?
  criado_em        DateTime @default(now())
}
